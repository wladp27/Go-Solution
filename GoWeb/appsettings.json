{


  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=gowebapplication_db;Uid=root;Pwd=Zipakokos27!;Pooling=false;"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "GoWeb.Controllers": "Information",
        "GoWeb.Areas": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/app-log.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },

  "JwtSettings": {
    "SecretKey": "SuperSecretLongKeyForGoWeb2026!YourSuperLongKeyHere",
    "Issuer": "GoWebBackend",
    "Audience": "GoWebClients"
  }
}



