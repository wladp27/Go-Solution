@inject IMediator mediator
@inject CityService cityService
@inject NavigationManager NavManager
@inject ToastService toastService
@implements IDisposable




@if ( typesEvent != null )
{
    if ( typesEvent.Count != 0)
    {
        <div class="container mt-4">
            <div class="row">
                @foreach (var type in typesEvent)
                {
                    <div class="col-md-4">
                        <TypeEventCard typeEvent="type" OnClick="(id)=>ClickCard(id)"> </TypeEventCard>
                    </div>
                }
            </div>
        </div>
    }
    else if (selectedIdCity != 0)
    {
        <StatusMessage Message="Событий в данном городе нет" Icon="bi-calendar-x" />
    }
    else
    {
        <StatusMessage Message="Выберите город" Icon="bi-geo-alt" />
    }
}
else
{
    <StatusMessage Message="Ошибка сервера попробуйте позже" Icon="bi-exclamation-triangle" IsError="true" />
}

@code
{
    [Parameter, SupplyParameterFromQuery]
    public int selectedIdCity { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public int selectedIdTypeEvent { get; set; }

    private int oldSelectedIdCity { get; set; }
    private List<EventTypeDTO> typesEvent = new();

    protected override async Task OnInitializedAsync()
    {
        cityService.OnChange += OnCityChanged;

    }

    protected override async Task OnParametersSetAsync()
    {
        if (selectedIdCity != 0 && oldSelectedIdCity != selectedIdCity)
        {
            oldSelectedIdCity = selectedIdCity;
            await LoadTypesEvents(selectedIdCity);
        }
        else if (selectedIdCity == 0 && cityService.SelectedCity != 0)
        {
            selectedIdCity = cityService.SelectedCity;
            oldSelectedIdCity = selectedIdCity;
            await LoadTypesEvents(cityService.SelectedCity);
        }

    }

    private async void OnCityChanged()
    {
        selectedIdCity = cityService.SelectedCity;
        await LoadTypesEvents(selectedIdCity);
        StateHasChanged();
    }

    public void Dispose()
    {
        cityService.OnChange -= OnCityChanged;
    }

    private async Task LoadTypesEvents(int idCity)
    {
        selectedIdCity = idCity;
        if (idCity != 0)
        {
            try
            {
                typesEvent = (await mediator.Send(new GetTypeEventsForCityRequest(selectedIdCity))).typesEvents ?? new();

            }
            catch (Exception ex)
            {
                typesEvent = null;
                await toastService.Error("Ошибка!", "Ошибка сервера");
            }
        }
        else
        {
            typesEvent = new();
        }
    }


    private Task ClickCard(int idTypeEvent)
    {
        var uriWithQuerystring = NavManager.GetUriWithQueryParameters(Routes.EventsCatalog, new Dictionary<string, object?>
            {
                [nameof(EventsCatalogPage.SelectedTypeEvent)] = idTypeEvent,
                [nameof(EventsCatalogPage.SelectedCity)] = selectedIdCity
            });
        NavManager.NavigateTo(uriWithQuerystring);
        return Task.CompletedTask;
    }




}