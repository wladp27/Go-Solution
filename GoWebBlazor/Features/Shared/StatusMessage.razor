<div class="d-flex flex-column align-items-center justify-content-center @TextColorClass" style="min-height: 50vh;">
    <i class="@Icon fs-1 mb-2"></i>
    <p class="fs-5">@Message</p>
</div>

@code {
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = "bi-info-circle"; 

    [Parameter]
    public bool IsError { get; set; } = false;

    private string TextColorClass => IsError ? "text-danger" : "text-muted";
}