
@inject AuthenticationStateProviderCustom authenticationStateProvider
<AuthorizeView>
    <Authorized>
        <Glass>
            <IconContent><i class="bi bi-person-fill"></i></IconContent>
            <ChildContent>
                <Window>
                    <TriggerContent>
                        <button class="btn form-control border-0 bg-transparent text-white shadow-none text-start" type="button">Профиль </button>
                    </TriggerContent>
                    <PopupContent>
                        <a href="authentication/login">Личный кабинет</a>
                        <div @onclick="Out">Выйти</div>
                    </PopupContent>
                </Window>
            </ChildContent>
        </Glass>
    </Authorized>

    <NotAuthorized>
        <Glass>
            <IconContent><i class="bi bi-person-fill"></i></IconContent>
            <ChildContent>
                <Window >
                    <TriggerContent>
                        <button class="btn form-control border-0 bg-transparent text-white shadow-none text-start" type="button">Войти</button>
                    </TriggerContent>
                    <PopupContent>

                        <a href="@Routes.Login">Войти</a>
                        <a href="authentication/register">Зарегистрироваться</a>
                    </PopupContent>
                </Window>
            </ChildContent>
        </Glass>
    </NotAuthorized>

</AuthorizeView>

@code
{


    public async Task Out()
    {
        await authenticationStateProvider.LogoutAsync();
    }
}