<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Go.Mobile"
             xmlns:components="clr-namespace:GoWeb.Shared.Features.Navigation;assembly=GoWeb.Shared"
             x:Class="Go.Mobile.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:AppRoute}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
