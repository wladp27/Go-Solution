@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.Event.Components
@using GoWeb.Shared.Features.Map.Components.Shared
@using GoWeb.Shared.Models
@using GoWeb.Shared.Service
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject CityService cityService
@inject ToastService toastService
@implements IAsyncDisposable
@implements IDisposable

<div @ref="mapRef" id="map" style="width: 100%; height: 500px; position: relative;"></div>




@code {

    [Parameter]
    public int IdCity { get; set;}

    [Parameter]
    public List<MapFeature> PointsList { get; set; } = new();

    [Parameter]
    public EventCallback<MapFeature[]> OnPointSelected { get; set; }

    private CityDTO selectedCity { get; set; } = new CityDTO { NameCity = "Самара", LocationLatitude = 50.100202, LocationLongitude = 53.195878 };
    private ElementReference mapRef;
    private IJSObjectReference? _routeMapModule;
    private IJSObjectReference? _mapInstance;
    private DotNetObjectReference<Map> _mapReference = default!;

    protected override async Task OnParametersSetAsync()
    {

        if(IdCity!=0)
        {
            var response = await cityService.GetCityById(IdCity);
            if (response.IsSuccess)
                selectedCity = response.Data;
            else
                await toastService.Error("Ошибка", response.ErrorMessage);
        }
    }  

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _mapReference = DotNetObjectReference.Create(this);
            string modulePath = "./_content/GoWeb.Shared/Features/Map/Components/Map.razor.js";
            _routeMapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", modulePath);
            _mapInstance = await _routeMapModule.InvokeAsync<IJSObjectReference>("initMapBookStyle", mapRef, selectedCity.LocationLatitude, selectedCity.LocationLongitude);

        }
        if (_mapInstance is not null && _routeMapModule is not null)
        {
            

            await _routeMapModule.InvokeVoidAsync("flyToCity", _mapInstance, selectedCity.LocationLatitude, selectedCity.LocationLongitude);
            await _routeMapModule.InvokeVoidAsync("addMarkers", _mapInstance, PointsList ?? new List<MapFeature>(), _mapReference);
        }

    }

   

  
    [JSInvokable]
    public void OnMarkerClicked(MapFeature[] points)
    {
        OnPointSelected.InvokeAsync(points);
    }

    public async Task<List<SearchResult>> SearchLocation(string query)
    {
        if (_routeMapModule is not null && _mapInstance is not null)
        {
            return await _routeMapModule.InvokeAsync<List<SearchResult>?>("searchLocation", selectedCity.NameCity + query) ?? new List<SearchResult>();

        }
        return new List<SearchResult>();
    }

    public record SearchResult(double Longitude, double Latitude, string Name, string Address);


    public async ValueTask DisposeAsync()
    {
        if (_routeMapModule is not null)
        {
            await _routeMapModule.DisposeAsync();
        }
    }

   

    public void Dispose()
    {
        _mapReference?.Dispose();
    }


   



}
