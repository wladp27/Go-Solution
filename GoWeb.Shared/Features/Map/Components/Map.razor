@using GoWeb.Shared.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @ref="mapRef" id="map" style="width: 100%; height: 500px; position: relative;"></div>

@code {
    [Parameter]
    public double LonCity { get; set; }

    [Parameter]
    public double LatCity { get; set; }

    [Parameter]
    public List<LocationDTO> ListLocation { get; set; } = new();

    private ElementReference mapRef;
    private IJSObjectReference? _routeMapModule;
    private IJSObjectReference? _mapInstance;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            string modulePath = "./_content/GoWeb.Shared/Features/Map/Components/Map.razor.js";

            _routeMapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", modulePath);
            _mapInstance = await _routeMapModule.InvokeAsync<IJSObjectReference>("initMapBookStyle", mapRef, LatCity, LonCity);
            
        }
        if (_mapInstance is not null && _routeMapModule is not null)
        {
            var pointsList = (ListLocation ?? new List<LocationDTO>()).Select(r => new
            {
                type = "Feature",
                id = r.Id,
                geometry = new
                {
                    type = "Point",
                    coordinates = new double[] { r.LocationLongitude, r.LocationLatitude }
                },
                properties = new
                {
                    name = r.Address
                }
            }).ToList();

    
            await _routeMapModule.InvokeVoidAsync("addMarkers", _mapInstance, pointsList);
            
        }
       
    }

    public async ValueTask DisposeAsync()
    {
        if (_routeMapModule is not null)
        {
            await _routeMapModule.DisposeAsync();
        }
    }
}