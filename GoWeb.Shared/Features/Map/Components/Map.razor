@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.Event.Components
@using GoWeb.Shared.Models
@using GoWeb.Shared.Service
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject CityService cityService
@inject ToastService toastService
@implements IAsyncDisposable
@implements IDisposable

<div @ref="mapRef" id="map" style="width: 100%; height: 500px; position: relative;"></div>

@if (isSelectedMarker)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Выбранные события</h5>
                    <button type="button" class="btn-close" @onclick="() => { isSelectedMarker = false; }"></button>
                </div>
                <div class="modal-body">
                    @if (seletedEvents != null && seletedEvents.Count != 0)
                    {
                        foreach (var ev in seletedEvents)
                        {
                            <EventCard SelectedEvent="ev"></EventCard>
                        }
                    }
                    else
                    {
                        <h5>Ошибка! Событие не найдено!</h5>
                    }
                </div>
            </div>
        </div>
    </div>
}


@code {

    [Parameter]
    public int IdCity { get; set;}

    [Parameter]
    public List<EventSummaryDTO> ListEvent { get; set; } = new();



    private CityDTO selectedCity { get; set; }
    private ElementReference mapRef;
    private IJSObjectReference? _routeMapModule;
    private IJSObjectReference? _mapInstance;
    private DotNetObjectReference<Map> _mapReference = default!;
    private bool isSelectedMarker = false;
    private List<EventSummaryDTO> seletedEvents = new();

    protected override async Task OnParametersSetAsync()
    {

        if(IdCity!=0)
        {
            var response = await cityService.GetCityById(IdCity);
            if (response.IsSuccess)
                selectedCity = response.Data;
            else
                await toastService.Error("Ошибка", response.ErrorMessage);
        }
        else
        {
            selectedCity = new CityDTO { NameCity = "Самара", LocationLatitude = 50.100202, LocationLongitude = 53.195878 };
        }
    }  

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _mapReference = DotNetObjectReference.Create(this);
            string modulePath = "./_content/GoWeb.Shared/Features/Map/Components/Map.razor.js";
            _routeMapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", modulePath);
            _mapInstance = await _routeMapModule.InvokeAsync<IJSObjectReference>("initMapBookStyle", mapRef, selectedCity.LocationLatitude, selectedCity.LocationLongitude);

        }
        if (_mapInstance is not null && _routeMapModule is not null)
        {
            var pointsList = (ListEvent ?? new List<EventSummaryDTO>()).Select(r => new
            {
                type = "Feature",
                id = r.Id,
                geometry = new
                {
                    type = "Point",
                    coordinates = new double[] { r.Location.LocationLongitude, r.Location.LocationLatitude }
                },
                properties = new
                {
                    name = r.EventName
                }
            }).ToList();

            await _routeMapModule.InvokeVoidAsync("flyToCity", _mapInstance, selectedCity.LocationLatitude, selectedCity.LocationLongitude);
            await _routeMapModule.InvokeVoidAsync("addMarkers", _mapInstance, pointsList, _mapReference);

        }

    }


    [JSInvokable]
    public void OpenEventInMap(int idEvent)
    {
        isSelectedMarker = true;
        seletedEvents.Clear();
        var selectedEvent = ListEvent.FirstOrDefault(e => e.Id == idEvent);
        if (selectedEvent != null) seletedEvents.Add(selectedEvent);
        StateHasChanged();
    }

    [JSInvokable]
    public void OpenEventsInMap(int[] idsEvents)
    {
        isSelectedMarker = true;
        seletedEvents.Clear();
        seletedEvents = ListEvent.Where(e => idsEvents.Contains(e.Id)).ToList();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_routeMapModule is not null)
        {
            await _routeMapModule.DisposeAsync();
        }
    }

    public void Dispose()
    {
        _mapReference?.Dispose();
    }

    



}