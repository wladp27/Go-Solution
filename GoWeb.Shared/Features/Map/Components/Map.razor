@using GoWeb.Shared.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@implements IDisposable

<div @ref="mapRef" id="map" style="width: 100%; height: 500px; position: relative;"></div>

@code {
    [Parameter]
    public double LonCity { get; set; }

    [Parameter]
    public double LatCity { get; set; }

    [Parameter]
    public List<EventSummaryDTO> ListEvent { get; set; } = new();

    private ElementReference mapRef;
    private IJSObjectReference? _routeMapModule;
    private IJSObjectReference? _mapInstance;
    private DotNetObjectReference<Map> _mapReference = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _mapReference = DotNetObjectReference.Create(this);
            string modulePath = "./_content/GoWeb.Shared/Features/Map/Components/Map.razor.js";
            _routeMapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", modulePath);
            _mapInstance = await _routeMapModule.InvokeAsync<IJSObjectReference>("initMapBookStyle", mapRef, LatCity, LonCity);

        }
        if (_mapInstance is not null && _routeMapModule is not null)
        {
            var pointsList = (ListEvent ?? new List<EventSummaryDTO>()).Select(r => new
            {
                type = "Feature",
                id = r.Id,
                geometry = new
                {
                    type = "Point",
                    coordinates = new double[] { r.Location.LocationLongitude, r.Location.LocationLatitude }
                },
                properties = new
                {
                    name = r.EventName
                }
            }).ToList();


            await _routeMapModule.InvokeVoidAsync("addMarkers", _mapInstance, pointsList, _mapReference);

        }

    }


    [JSInvokable]
    public void OpenEventInMap(int idEvent)
    {
        Console.WriteLine(idEvent);
    }

    public async ValueTask DisposeAsync()
    {
        if (_routeMapModule is not null)
        {
            await _routeMapModule.DisposeAsync();
        }
    }

    public void Dispose()
    {
        _mapReference?.Dispose();
    }

    



}