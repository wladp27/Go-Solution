@using GoWeb.Shared.Features.Shared
@using GoWeb.Shared.Сonstants
@inject NavigationManager navigationManager

@if (List != null)
{
    <div class="container mt-4">
        <div class="row gy-3">
            @foreach (var ev in List)
            {
                <div class="col-md-4">
                    <EventCard SelectedEvent="ev"> </EventCard> 
                </div>
            }
        </div>
    </div>
}
else
{
    <StatusMessage Message="Ошибка сервера попробуйте позже" Icon="bi-exclamation-triangle" IsError="true" />
}


@code
{
    [Parameter, EditorRequired]
    public List<EventSummaryDTO> List { get; set; } = default!;
}