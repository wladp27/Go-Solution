@using BootstrapBlazor.Components
@using GoWeb.Shared.Сonstants

@inject NavigationManager navigationManager
@inject ToastService toastService
@inject IMediator mediator

<button class="btn btn-primary w-100 py-2 fw-bold shadow-sm"
        @onclick="HandleButtonClick"
        disabled="@_isSubscribing">
    @if (_isSubscribing)
    {
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        <span>Обработка...</span>
    }
    else
    {
        <i class="@GetIconClass() me-1"></i>
        <span>@GetButtonText()</span>
    }

</button>

@code {
    [Parameter, EditorRequired]
    public bool IsAuthenticated{ get; set; }
    [Parameter, EditorRequired]
    public bool IsRegisteredInEvent{ get; set; }
    [Parameter, EditorRequired]
    public int IdEvent{ get; set; }
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _isSubscribing = false;
    private string GetButtonText() => !IsAuthenticated ? "Войти для участия" : IsRegisteredInEvent ? "Выписаться из события" : "Записаться на событие";
    private string GetIconClass() => !IsAuthenticated ? "bi bi-box-arrow-in-right" : IsRegisteredInEvent ? "bi bi-x-circle" : "bi bi-check2-circle";
    private async Task HandleButtonClick()
    {
        if (!IsAuthenticated)
        {
            navigationManager.NavigateTo(Routes.Login);
            return;
        }

        if (IdEvent == 0) return;
        _isSubscribing = true;
        if (IsRegisteredInEvent)
        {
            var response = await mediator.Send(new LeaveEventRequest(IdEvent));
            if (response.IsSuccess)
                await HandleResponseAsync(true, response.Data.Message);
            else
                await HandleResponseAsync(false, response.ErrorMessage);
        }
        else
        {
            var response = await mediator.Send(new JoinEventRequest(IdEvent));
            if (response.IsSuccess)
                await HandleResponseAsync(true, response.Data.Message);
            else
                await HandleResponseAsync(false, response.ErrorMessage);
        }
        
        await OnChanged.InvokeAsync();
         _isSubscribing = false;
     
    }

    private async Task HandleResponseAsync(bool isSuccess, string message)
    {
        if (isSuccess)
        {
            await toastService.Success("Успех", message);
        }
        else
        {
            await toastService.Error("Ошибка", message);
        }
    }


}
