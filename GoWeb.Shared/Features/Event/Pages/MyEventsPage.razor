@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.Event.Components
@page "/my-events"
@attribute [Authorize]

@inject IMediator mediator
@inject ToastService toastService
<h3>Мои события</h3>
<AuthorizeView>
	<Authorized>
		@if (logading)
		{
			<div class="spinner-border" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
		}
		else
		{
			<EventList List="list"></EventList>
		}
	</Authorized>
	<NotAuthorized>
		Войдите в систему
	</NotAuthorized>
</AuthorizeView>



@code {
	private List<EventSummaryDTO> list { get; set; } = default!;
	private bool logading=false;
	private bool canManage = false;
	private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

	protected override async Task OnInitializedAsync()
	{

		logading = true;
		var response = await mediator.Send(new GetMyEventsRequest());
		if (response.IsSuccess)
		{
			list = response.Data.eventSummary;
			logading = false;
		}
		else
		{
			await toastService.Error("Ошибка", response.ErrorMessage);
		}
	}


	

}
