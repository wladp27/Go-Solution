@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.Components.Authorization
@page "/my-events"
@inject IMediator mediator
@inject ToastService toastService
<h3>Мои события</h3>
<AuthorizeView>
	<Authorized>
		@if (logading)
		{
			<div class="spinner-border" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
		}
		else
		{
			<EventList List="list"></EventList>
		}
	</Authorized>
	<NotAuthorized>
		Войдите в систему
	</NotAuthorized>
</AuthorizeView>



@code {
	private List<EventSummaryDTO> list { get; set; } = default!;
	private bool logading=false;
	protected override async Task OnInitializedAsync()
	{
		try
		{
			logading = true;
			var response = await mediator.Send(new GetMyEventsRequest());
			if (response != null && response.eventSummary != null)
			{
				list = response.eventSummary;
				logading = false;
			}
			
		}
		catch(Exception ex)
		{
			list = new();
			await toastService.Error("Ошибка", ex.Message); 
		}
	}


}
