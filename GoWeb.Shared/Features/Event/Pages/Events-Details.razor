@page "/events-details/{IdEvent:int}"
@inject NavigationManager navigationManager
@inject IMediator mediator
@inject HttpClient httpClient
@inject IJSRuntime JS

<PageTitle>@(currentEvent?.EventName ?? "Детали события")</PageTitle>

<div class="container py-4">
    @if (isLoading)
    {
        <!-- Индикатор загрузки -->
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загружаем информацию о событии...</p>
        </div>
    }
    else if (currentEvent == null)
    {
        <!-- Ошибка, если событие не найдено -->
        <div class="my-5">
            <StatusMessage Message="Событие не найдено или было удалено" Icon="bi-calendar-x" />
            <div class="text-center mt-3">
                <button class="btn btn-outline-primary" @onclick="GoBack">Вернуться назад</button>
            </div>
        </div>
    }
    else
    {
        <!-- Кнопка возврата -->
        <div class="mb-3">
            <button class="btn btn-outline-secondary btn-sm px-3" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> Назад
            </button>
        </div>

        <!-- Шапка (Hero-блок) -->
        <div class="card shadow-sm border-0 mb-4 overflow-hidden">
            @if (!string.IsNullOrEmpty(currentEvent.ImagePath))
            {
                <div style="height: 320px; background-image: linear-gradient(to top, rgba(0,0,0,2.6), transparent), url('@(httpClient.BaseAddress + currentEvent.ImagePath)'); background-size: cover; background-position: center; background-repeat: no-repeat; position: relative;">

                    <div class="position-absolute bottom-0 start-0 p-4 text-white">
                        <h1 class="h2 fw-bold text-white mb-0">@currentEvent.EventName</h1>
                    </div>

                </div>
            }
            else
            {
                <div class="bg-primary bg-gradient text-white p-5 text-center">
                    <i class="bi bi-calendar-event display-1 mb-2"></i>
                    <h1 class="h2 fw-bold">@currentEvent.EventName</h1>
                </div>
            }
            <div class="card-body p-3 px-4 bg-light border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <i class="bi bi-person-badge text-secondary me-1"></i> Организатор:
                    <strong class="text-dark">@(string.IsNullOrEmpty(currentEvent.OrganizerName) ? "Не указан" : currentEvent.OrganizerName)</strong>
                </div>
                <div>
                    <span class="badge bg-success fs-6 px-3 py-2">
                        @(currentEvent.Price == 0 ? "Бесплатно" : $"{currentEvent.Price:N0} ₽")
                    </span>
                </div>
            </div>
        </div>

        <!-- Основной контент (Две колонки) -->
        <div class="row g-4">

            <!-- Левая колонка: Описание и Место -->
            <div class="col-lg-8">
                <!-- Описание -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <h4 class="card-title fw-bold mb-3">
                            <i class="bi bi-info-circle text-primary me-2"></i>О событии
                        </h4>
                        @if (!string.IsNullOrEmpty(currentEvent.EventDescription))
                        {
                            <p class="card-text text-secondary lh-lg" style="white-space: pre-line;">@currentEvent.EventDescription</p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0">Описание к этому событию еще не добавлено.</p>
                        }
                    </div>
                </div>

                <!-- Локация -->
                @if (currentEvent.Location != null)
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold mb-3">
                                <i class="bi bi-geo-alt text-danger me-2"></i>Место проведения
                            </h4>
                            <p class="mb-1 fw-bold">@currentEvent.Location.Address</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Правая колонка: Сайдбар с деталями и действиями -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px; z-index: 10;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Детали сеанса</h5>

                        <ul class="list-unstyled mb-4">
                            <li class="mb-3 d-flex align-items-start">
                                <i class="bi bi-calendar-check text-primary fs-5 me-3 mt-1"></i>
                                <div>
                                    <small class="text-muted d-block">Начало</small>
                                    <strong class="text-dark">@currentEvent.StartTime.ToString("dd MMMM yyyy, HH:mm")</strong>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="bi bi-calendar-x text-danger fs-5 me-3 mt-1"></i>
                                <div>
                                    <small class="text-muted d-block">Окончание</small>
                                    <strong class="text-dark">@currentEvent.EndTime.ToString("dd MMMM yyyy, HH:mm")</strong>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="bi bi-people text-success fs-5 me-3 mt-1"></i>
                                <div>
                                    <small class="text-muted d-block">Участники</small>
                                    <strong class="text-dark">@currentEvent.CountRegisteredUsers</strong> из @currentEvent.MaxParticipants
                                    <span class="text-muted small d-block">(мин. @currentEvent.MinParticipants)</span>
                                </div>
                            </li>
                            <li class="d-flex align-items-start">
                                <i class="bi bi-award text-warning fs-5 me-3 mt-1"></i>
                                <div>
                                    <small class="text-muted d-block">Требуемый рейтинг</small>
                                    <strong class="text-dark">@currentEvent.RequiredRating</strong>
                                </div>
                            </li>
                        </ul>

                        <button class="btn btn-primary w-100 py-2 fw-bold shadow-sm" @onclick="RegisterAction">
                            <i class="bi bi-check2-circle me-1"></i> Записаться на событие
                        </button>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter]
    public int IdEvent { get; set; }

    private EventSummaryDTO? currentEvent;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEventAsync();
    }

    private async Task LoadEventAsync()
    {
        isLoading = true;
        try
        {
            var state = navigationManager.HistoryEntryState;

            if (!string.IsNullOrEmpty(state))
            {
                var parsedEvent = System.Text.Json.JsonSerializer.Deserialize<EventSummaryDTO>(state);

                if (parsedEvent != null && parsedEvent.Id == IdEvent)
                {
                    currentEvent = parsedEvent;
                    isLoading = false;
                    return;
                }
            }
            var response = await mediator.Send(new GetEventRequest(IdEvent)); 
            if (response != null)
            {
                currentEvent = response.eventSummary;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private void RegisterAction()
    {
        // Здесь логика записи на событие
    }
}