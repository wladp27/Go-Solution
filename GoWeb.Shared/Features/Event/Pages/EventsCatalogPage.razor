@inject IMediator Mediator
@inject ToastService toastService;
@inject NavigationManager navigationManager;

@page "/events"
@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.Event.Components
@using GoWeb.Shared.Features.Map.Components
@using GoWeb.Shared.Features.Shared
<h3>Каталог событий</h3>



<EventFilter FilterEvent="filterDTO"></EventFilter>
@if (SelectedCity == 0)
{
    <StatusMessage Message="Выберите город" Icon="bi-building" />
}
else
{
   <Map LatCity="53.195878" LonCity="50.100202" ListLocation="@list.Select(e=>e.Location).ToList()"/>
   <EventList List="list"> </EventList>
}

@code
{

    [Parameter, SupplyParameterFromQuery]
    public int SelectedCity { get; set; }
    [Parameter, SupplyParameterFromQuery]
    public int SelectedTypeEvent { get; set; }

    private EventFilterDTO filterDTO { get; set; } = new();

    private List<EventSummaryDTO> list { get; set; } = new();



    protected override async Task  OnParametersSetAsync()
    {
        filterDTO.SelectedCity = SelectedCity;
        filterDTO.SelectedTypeEvent = SelectedTypeEvent;
        if (SelectedCity!=0)
        {
            var listNew = new List<EventSummaryDTO>();
            var resultRequred = await Mediator.Send(new GetPublishedEventsRequest(filterDTO));
            var resultKtoKuda = await Mediator.Send(new GetEventKtoKudaRequest());
            if (resultRequred.IsSuccess)
            {
                listNew = resultRequred.Data.EventsSummary;
            }

            if (resultKtoKuda.IsSuccess)
            {
           //    listNew.AddRange(resultKtoKuda.Data.Events);
            }
            else
            {
                await toastService.Error("Ошибка", resultKtoKuda.ErrorMessage);
            }

            if (listNew == null)
            {
                await toastService.Error("Ошибка", "Ошибка сервера, либо сервер не доступен");
                list = new();
            }
            else
                list = listNew;
        }

    }


}