@page "/create-event"
@attribute [Authorize]

@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.Manage.Components.EventForm
@using GoWeb.Shared.Model
@using GoWeb.Shared.Requests
@using GoWeb.Shared.Сonstants
@using MediatR
@using static GoWeb.Shared.Model.EventDTO

@inject NavigationManager NavigationManager
@inject IMediator mediator
@inject ToastService toastService

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-8 col-md-6 col-lg-8">
            <h2 class="h3 fw-bold text-dark mb-2 text-center">Создать событие</h2>
            <EventForm OnSubmit="CreateEvent"></EventForm>
        </div>
    </div>
</div>



@code {

    private async Task CreateEvent(EventDTO eventCreate, IBrowserFile browserFile)
    {
        if(eventCreate!=null)
        {
            if (eventCreate.imageAction == ImageAction.Add && browserFile != null)  
            {
                var result = await mediator.Send(new AddImageEventRequest(browserFile));
                if (result.IsSuccess)
                {
                    eventCreate.ImagePath = result.Data;
                    var response = await mediator.Send(new CreateEventRequest(eventCreate));
                    if (response.IsSuccess)
                    {
                        await toastService.Success("Успешно", "Событие успешно создано.");
                        NavigationManager.NavigateTo(Routes.EventDetails.Replace("{IdEvent}", response.EventId.ToString()));
                    }
                    else
                    {
                        await toastService.Error("Ошибка", $"{response.ErrorMessage}");
                        return;
                    }
                }
                else
                {
                    await toastService.Error("Ошибка", $"{result.ErrorMessage}");
                    return;
                }
            }
        }
        else
        {
            await toastService.Error("Ошибка", "Данные события не могут быть пустыми.");
            return;
        }
    }

}
