@using System.Diagnostics.CodeAnalysis
@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.ManageEvent.Components.CreateLocation
@using GoWeb.Shared.Features.Shared
@using GoWeb.Shared.Model
@using GoWeb.Shared.Models
@using GoWeb.Shared.Requests
@using GoWeb.Shared.Service
@using MediatR 

@inherits InputBase<int>
@inject CityService cityService
@inject IMediator mediator
@inject ToastService toastService
@if (!isCreatingNew)
{
    <div class="row">
        <div class="col-md-6">
            <InputSelect @bind-Value="selectedIdCity" class="form-select" disabled="@disabled">
                <option value=0>--Выбрать--</option>
                @foreach (var city in cities ?? new())
                {
                    <option value="@city.Id">@city.NameCity</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6">
            @if (selectedIdCity != 0)
            {
                <SearchDropdown SearchItems="SearchLocation"
                OnSelectItem="(LocationPreviewDTO location) => SelectFilteredLocation(location)"
                FullNameItem="(LocationPreviewDTO location) => location.Address"
                InputClassValidator="@CssClass"
                disabled="@disabled">
                </SearchDropdown>
            }
        </div>
    </div> 
}
else
{
    if (!isSelectedLocation)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Создание новой локации</h5>
                        <button type="button" class="btn-close" @onclick="() => { isCreatingNew = false; }"></button>
                    </div>
                    <div class="modal-body">
                        <LocationForm OnCreate="HandleLocationCreated" />
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <input class="form-control " type="text" value="@(cities.FirstOrDefault(c => c.Id == selectedIdCity)?.NameCity ?? "Неизвестный город")" disabled />
           </div>
           <div class="col-md-6">
                <input class="form-control " type="text" value="@selectedNameAddress" disabled />
           </div>
        </div>
    }
 }

<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault" @onclick="CheckBoxCreatingLocation">
    <label class="form-check-label" for="flexSwitchCheckDefault">Создать новую локацию</label>
</div>





@code {
    private int selectedIdCity;
    private int selectedIdLocation;
    private List<CityDTO> cities = default!;
    private bool disabled;
    private bool isCreatingNew = false;
    private string selectedNameAddress ="";
    private bool isSelectedLocation = false;

    private List<LocationPreviewDTO> filteredLocation = default!;

    protected override async Task OnInitializedAsync()
    {
        var result = await cityService.GetCities();
        if(result.IsSuccess)
        {
            cities = result.Data?? new();
        }
        else
        {
            cities = new();
            disabled = true;
        }
    }



    private void SelectFilteredLocation(LocationPreviewDTO locationDTO)
    {
        if (locationDTO != null)
        {
            CurrentValue = locationDTO.Id;
            isSelectedLocation = true;
        }

        else
        {
            isSelectedLocation = false;
            toastService.Error("Ошибка", "Ошибка при выборе локации");
        }
    }


    private async Task<List<LocationPreviewDTO>> SearchLocation(string strinSearch) 
    {
        CurrentValue = 0;
        var locationName = strinSearch ?? "";
        if (!disabled && !string.IsNullOrEmpty(locationName) && selectedIdCity!=0)
        {

            var response = await mediator.Send(new GetFilteredLocationsRequest(locationName, selectedIdCity));
            if(response.IsSuccess)
            {
                var filteredLocation = response.Data ?? new();
                return filteredLocation;
            }
            else
            {
                await toastService.Error("Ошибка", "Непредвиденная ошибка получения локаций");
            }
        }
        return new();
    }

    protected override bool TryParseValueFromString(string value, [MaybeNullWhen(false)] out int result, [NotNullWhen(false)] out string validationErrorMessage)
    {
        throw new NotImplementedException();
    }

    private async Task HandleLocationCreated(LocationCreateDTO locationCreate)
    {
        CurrentValue = locationCreate.Id;
        selectedIdCity = locationCreate.CityId;
        selectedNameAddress = locationCreate.Address;
        isSelectedLocation = true;
    }

    private async Task CheckBoxCreatingLocation()
    {
        isCreatingNew = !isCreatingNew;
        Reset();
    }

    private void Reset()
    {
        CurrentValue = 0;
        selectedIdCity = 0;
        selectedNameAddress = "";
        isSelectedLocation = false;
    }
}
