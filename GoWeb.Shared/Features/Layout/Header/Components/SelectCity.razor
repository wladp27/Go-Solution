@using BootstrapBlazor.Components
@using GoWeb.Shared.Features.Layout.Shared.Components
@using GoWeb.Shared.Service
@using GoWeb.Shared.Service.State
@inject CityService cityService
@inject ToastService toastService
@inject AppState appState
@inject AuthenticationStateProviderCustom authenticationStateProvider
@implements IDisposable

<Glass>
    <IconContent>
        <i class="bi bi-geo-alt-fill"></i>
    </IconContent>
    <ChildContent>
        <InputSelect Value="selectedIdCity"
        ValueChanged="@((int val) => OnCityChanged(val))"
        ValueExpression="() => selectedIdCity" class="form-select border-0 bg-transparent text-white shadow-none">
            <option value="0" style="color: #333; background-color: #fff;">Выберите город...</option>
            @foreach (var city in cities)
            {
                <option value="@city.Id" style="color: #333; background-color: #fff;">@city.NameCity</option>
            }
        </InputSelect>
    </ChildContent>
</Glass>

@code 
{
    public int selectedIdCity;
    private List<CityDTO> cities = new();

    protected override async Task OnInitializedAsync()
    {
        appState.selectCityState.OnChange += OnUpdateCityIdStateChanged;
        selectedIdCity = appState.selectCityState.SelectedCityId ;
        var result = await cityService.GetCities();
        if (result.IsSuccess)
        {
            cities = result.Data ?? new();
        }
        else
        {
            await toastService.Error("Ошибка", result.ErrorMessage);
            StateHasChanged();  //иначе в интерфейсе не обновится вывод ошибки сверху
        }
    }


    private async void OnUpdateCityIdStateChanged(int idCity)
    {
        selectedIdCity = idCity;
        StateHasChanged();
    }

    private  async Task OnCityChanged(int newCityId)
    {
        await appState.selectCityState.SetIdCity(newCityId);
	}


    public void Dispose()
    {
        appState.selectCityState.OnChange -= OnUpdateCityIdStateChanged;
    }
}
